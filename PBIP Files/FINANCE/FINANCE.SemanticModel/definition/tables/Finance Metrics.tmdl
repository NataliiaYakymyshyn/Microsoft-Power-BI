	measure 'ABC Card Value' =
			
			VAR _Axis  = SELECTEDVALUE ( 'Pareto Axis'[Parameter Order], 3 )
			VAR _Class = SELECTEDVALUE ( 'Pareto Class'[Class Order] )
			
			VAR _ByProduct =
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_product[Product] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = dim_product[Product]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_product[Product] <= _k ) ), [@V] ), _Total )
			        )
			    VAR _TCl = ADDCOLUMNS ( _TC, "@Class", SWITCH ( TRUE (), [@Cum] <= 0.80, 1, [@Cum] <= 0.95, 2, 3 ) )
			    RETURN COUNTROWS ( FILTER ( _TCl, [@Class] = _Class ) )
			
			VAR _ByCountry =
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_country[Country] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = dim_country[Country]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_country[Country] <= _k ) ), [@V] ), _Total )
			        )
			    VAR _TCl = ADDCOLUMNS ( _TC, "@Class", SWITCH ( TRUE (), [@Cum] <= 0.80, 1, [@Cum] <= 0.95, 2, 3 ) )
			    RETURN COUNTROWS ( FILTER ( _TCl, [@Class] = _Class ) )
			
			VAR _BySegment =
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_segment[Segment] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = dim_segment[Segment]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_segment[Segment] <= _k ) ), [@V] ), _Total )
			        )
			    VAR _TCl = ADDCOLUMNS ( _TC, "@Class", SWITCH ( TRUE (), [@Cum] <= 0.80, 1, [@Cum] <= 0.95, 2, 3 ) )
			    RETURN COUNTROWS ( FILTER ( _TCl, [@Class] = _Class ) )
			
			VAR _ByCombination =
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( fact_finance[Pareto Key] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = fact_finance[Pareto Key]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && fact_finance[Pareto Key] <= _k ) ), [@V] ), _Total )
			        )
			    VAR _TCl = ADDCOLUMNS ( _TC, "@Class", SWITCH ( TRUE (), [@Cum] <= 0.80, 1, [@Cum] <= 0.95, 2, 3 ) )
			    RETURN COUNTROWS ( FILTER ( _TCl, [@Class] = _Class ) )
			
			RETURN
			    ( SWITCH ( _Axis, 0, _ByProduct, 1, _ByCountry, 2, _BySegment, _ByCombination ) + 0 ) & " items"
