		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pareto Cumulative %' =
			
			VAR _Axis    = SELECTEDVALUE ( 'Pareto Axis'[Parameter Order], 3 )
			VAR _Current = [Pareto Metric Value]
			
			VAR _ByProduct =
			    VAR _Key   = SELECTEDVALUE ( dim_product[Product] )
			    VAR _Items = ADDCOLUMNS ( ALLSELECTED ( dim_product[Product] ), "@V", [Pareto Metric Value] )
			    RETURN
			        DIVIDE (
			            SUMX ( FILTER ( _Items, [@V] > _Current || ( [@V] = _Current && dim_product[Product] <= _Key ) ), [@V] ),
			            SUMX ( _Items, [@V] )
			        )
			
			VAR _ByCountry =
			    VAR _Key   = SELECTEDVALUE ( dim_country[Country] )
			    VAR _Items = ADDCOLUMNS ( ALLSELECTED ( dim_country[Country] ), "@V", [Pareto Metric Value] )
			    RETURN
			        DIVIDE (
			            SUMX ( FILTER ( _Items, [@V] > _Current || ( [@V] = _Current && dim_country[Country] <= _Key ) ), [@V] ),
			            SUMX ( _Items, [@V] )
			        )
			
			VAR _BySegment =
			    VAR _Key   = SELECTEDVALUE ( dim_segment[Segment] )
			    VAR _Items = ADDCOLUMNS ( ALLSELECTED ( dim_segment[Segment] ), "@V", [Pareto Metric Value] )
			    RETURN
			        DIVIDE (
			            SUMX ( FILTER ( _Items, [@V] > _Current || ( [@V] = _Current && dim_segment[Segment] <= _Key ) ), [@V] ),
			            SUMX ( _Items, [@V] )
			        )
			
			VAR _ByCombination =
			    VAR _Key   = SELECTEDVALUE ( fact_finance[Pareto Key] )
			    VAR _Items = ADDCOLUMNS ( ALLSELECTED ( fact_finance[Pareto Key] ), "@V", [Pareto Metric Value] )
			    RETURN
			        DIVIDE (
			            SUMX ( FILTER ( _Items, [@V] > _Current || ( [@V] = _Current && fact_finance[Pareto Key] <= _Key ) ), [@V] ),
			            SUMX ( _Items, [@V] )
			        )
			
			RETURN
			    IF (
			        NOT ISBLANK ( _Current ),
			        SWITCH ( _Axis, 0, _ByProduct, 1, _ByCountry, 2, _BySegment, _ByCombination )
			    )
			// Format: 0%
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Pareto
		lineageTag: 06d313c6-07b7-482e-b2a9-bca5042f9548

	measure 'Pareto Threshold' =
			
			0.8
		displayFolder: Pareto
		lineageTag: f0388a7a-fc7e-4c34-bacb-d584b75c14c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pareto Class Color' =
			
			VAR _Cum = [Pareto Cumulative %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Cum ), BLANK (),
			        _Cum <= 0.80, "#2C3E50",
			        _Cum <= 0.95, "#3F8E96",
			                      "#BF9F74"
			    )
		displayFolder: Pareto
		lineageTag: 88da209e-41da-432b-ac44-585e2204217e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pareto Metric Value' =
			
			SWITCH (
			    SELECTEDVALUE ( KPIs[Parameter Order], 0 ),
			    0, [Total Sales],
			    1, [Units Sold],
			    2, [Total Discounts],
			    3, [Total COGS]
			)
		displayFolder: Pareto
		lineageTag: 62b56895-716d-4269-b442-9dd43d03da2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pareto Class' =
			
			VAR _Cum = [Pareto Cumulative %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Cum ), BLANK (),
			        _Cum <= 0.80, "A",
			        _Cum <= 0.95, "B",
			                      "C"
			    )
		displayFolder: Pareto
		lineageTag: ae3b17a2-a5ae-476a-b66d-e2fbf18b28bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pareto Class Order' =
			
			VAR _Axis = SELECTEDVALUE ( 'Pareto Axis'[Parameter Order], 3 )
			
			VAR _ByProduct =
			    VAR _Key   = SELECTEDVALUE ( dim_product[Product] )
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_product[Product] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = dim_product[Product]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_product[Product] <= _k ) ), [@V] ), _Total ),
			            "@Prev",
			                VAR _v = [@V] VAR _k = dim_product[Product]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_product[Product] < _k ) ), [@V] ), _Total ) + 0
			        )
			    VAR _TCl = ADDCOLUMNS ( _TC, "@Class", SWITCH ( TRUE (), [@Prev] < 0.80, 1, [@Prev] < 0.95, 2, 3 ) )
			    RETURN MAXX ( FILTER ( _TCl, dim_product[Product] = _Key ), [@Class] )
			
			VAR _ByCountry =
			    VAR _Key   = SELECTEDVALUE ( dim_country[Country] )
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_country[Country] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = dim_country[Country]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_country[Country] <= _k ) ), [@V] ), _Total ),
			            "@Prev",
			                VAR _v = [@V] VAR _k = dim_country[Country]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_country[Country] < _k ) ), [@V] ), _Total ) + 0
			        )
			    VAR _TCl = ADDCOLUMNS ( _TC, "@Class", SWITCH ( TRUE (), [@Prev] < 0.80, 1, [@Prev] < 0.95, 2, 3 ) )
			    RETURN MAXX ( FILTER ( _TCl, dim_country[Country] = _Key ), [@Class] )
			
			VAR _BySegment =
			    VAR _Key   = SELECTEDVALUE ( dim_segment[Segment] )
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_segment[Segment] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = dim_segment[Segment]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_segment[Segment] <= _k ) ), [@V] ), _Total ),
			            "@Prev",
			                VAR _v = [@V] VAR _k = dim_segment[Segment]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_segment[Segment] < _k ) ), [@V] ), _Total ) + 0
			        )
			    VAR _TCl = ADDCOLUMNS ( _TC, "@Class", SWITCH ( TRUE (), [@Prev] < 0.80, 1, [@Prev] < 0.95, 2, 3 ) )
			    RETURN MAXX ( FILTER ( _TCl, dim_segment[Segment] = _Key ), [@Class] )
			
			VAR _ByCombination =
			    VAR _Key   = SELECTEDVALUE ( fact_finance[Pareto Key] )
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( fact_finance[Pareto Key] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = fact_finance[Pareto Key]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && fact_finance[Pareto Key] <= _k ) ), [@V] ), _Total ),
			            "@Prev",
			                VAR _v = [@V] VAR _k = fact_finance[Pareto Key]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && fact_finance[Pareto Key] < _k ) ), [@V] ), _Total ) + 0
			        )
			    VAR _TCl = ADDCOLUMNS ( _TC, "@Class", SWITCH ( TRUE (), [@Prev] < 0.80, 1, [@Prev] < 0.95, 2, 3 ) )
			    RETURN MAXX ( FILTER ( _TCl, fact_finance[Pareto Key] = _Key ), [@Class] )
			
			RETURN
			    SWITCH ( _Axis, 0, _ByProduct, 1, _ByCountry, 2, _BySegment, _ByCombination )
		displayFolder: Pareto
		lineageTag: 95850056-8bcb-4bc4-864e-616fc00ba7ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Key Insight' =
			
			VAR _Axis     = SELECTEDVALUE ( 'Pareto Axis'[Parameter Order], 3 )
			VAR _MetricNo = SELECTEDVALUE ( KPIs[Parameter Order], 0 )
			
			VAR _AxisName =
			    SWITCH ( _Axis, 0, "product", 1, "country", 2, "segment", "combination" )
			VAR _Metric =
			    SWITCH ( _MetricNo, 0, "Total Sales", 1, "Units Sold", 2, "Total Discounts", "Total COGS" )
			
			VAR _ByProduct =
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_product[Product] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = dim_product[Product]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_product[Product] <= _k ) ), [@V] ), _Total )
			        )
			    VAR _A   = FILTER ( _TC, [@Cum] <= 0.80 )
			    VAR _Top = TOPN ( 1, _T, [@V], DESC, dim_product[Product], ASC )
			    RETURN
			        COUNTROWS ( _A ) + 0 & "|" & COUNTROWS ( _T ) + 0 & "|"
			            & ROUND ( DIVIDE ( SUMX ( _A, [@V] ), _Total ) * 10000, 0 ) & "|"
			            & ROUND ( DIVIDE ( MAXX ( _Top, [@V] ), _Total ) * 10000, 0 ) & "|"
			            & MAXX ( _Top, dim_product[Product] )
			
			VAR _ByCountry =
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_country[Country] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = dim_country[Country]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_country[Country] <= _k ) ), [@V] ), _Total )
			        )
			    VAR _A   = FILTER ( _TC, [@Cum] <= 0.80 )
			    VAR _Top = TOPN ( 1, _T, [@V], DESC, dim_country[Country], ASC )
			    RETURN
			        COUNTROWS ( _A ) + 0 & "|" & COUNTROWS ( _T ) + 0 & "|"
			            & ROUND ( DIVIDE ( SUMX ( _A, [@V] ), _Total ) * 10000, 0 ) & "|"
			            & ROUND ( DIVIDE ( MAXX ( _Top, [@V] ), _Total ) * 10000, 0 ) & "|"
			            & MAXX ( _Top, dim_country[Country] )
			
			VAR _BySegment =
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_segment[Segment] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = dim_segment[Segment]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && dim_segment[Segment] <= _k ) ), [@V] ), _Total )
			        )
			    VAR _A   = FILTER ( _TC, [@Cum] <= 0.80 )
			    VAR _Top = TOPN ( 1, _T, [@V], DESC, dim_segment[Segment], ASC )
			    RETURN
			        COUNTROWS ( _A ) + 0 & "|" & COUNTROWS ( _T ) + 0 & "|"
			            & ROUND ( DIVIDE ( SUMX ( _A, [@V] ), _Total ) * 10000, 0 ) & "|"
			            & ROUND ( DIVIDE ( MAXX ( _Top, [@V] ), _Total ) * 10000, 0 ) & "|"
			            & MAXX ( _Top, dim_segment[Segment] )
			
			VAR _ByCombination =
			    VAR _T     = FILTER ( ADDCOLUMNS ( ALLSELECTED ( fact_finance[Pareto Key] ), "@V", [Pareto Metric Value] ), NOT ISBLANK ( [@V] ) )
			    VAR _Total = SUMX ( _T, [@V] )
			    VAR _TC =
			        ADDCOLUMNS (
			            _T,
			            "@Cum",
			                VAR _v = [@V] VAR _k = fact_finance[Pareto Key]
			                RETURN DIVIDE ( SUMX ( FILTER ( _T, [@V] > _v || ( [@V] = _v && fact_finance[Pareto Key] <= _k ) ), [@V] ), _Total )
			        )
			    VAR _A   = FILTER ( _TC, [@Cum] <= 0.80 )
			    VAR _Top = TOPN ( 1, _T, [@V], DESC, fact_finance[Pareto Key], ASC )
			    RETURN
			        COUNTROWS ( _A ) + 0 & "|" & COUNTROWS ( _T ) + 0 & "|"
			            & ROUND ( DIVIDE ( SUMX ( _A, [@V] ), _Total ) * 10000, 0 ) & "|"
			            & ROUND ( DIVIDE ( MAXX ( _Top, [@V] ), _Total ) * 10000, 0 ) & "|"
			            & MAXX ( _Top, fact_finance[Pareto Key] )
			
			VAR _Packed =
			    SWITCH ( _Axis, 0, _ByProduct, 1, _ByCountry, 2, _BySegment, _ByCombination )
			
			VAR _ClassA      = VALUE ( PATHITEM ( _Packed, 1 ) )
			VAR _Items       = VALUE ( PATHITEM ( _Packed, 2 ) )
			VAR _ValueShareA = VALUE ( PATHITEM ( _Packed, 3 ) ) / 10000
			VAR _TopShare    = VALUE ( PATHITEM ( _Packed, 4 ) ) / 10000
			VAR _TopName     = PATHITEM ( _Packed, 5 )
			
			VAR _ShareA = DIVIDE ( _ClassA, _Items )
			
			VAR _Level =
			    SWITCH (
			        TRUE (),
			        _ClassA = 0,     "highly concentrated",
			        _ShareA <= 0.30, "highly concentrated",
			        _ShareA <= 0.50, "moderately concentrated",
			                         "fairly evenly distributed"
			    )
			
			VAR _Action =
			    SWITCH (
			        _MetricNo,
			        0, "These are the key revenue drivers to protect.",
			        1, "These items drive most of the volume.",
			        2, "Discount policy review should start here.",
			        3, "Cost-reduction efforts here have the biggest impact."
			    )
			
			VAR _Core =
			    IF (
			        _ClassA = 0,
			        "the top item alone accounts for " & FORMAT ( _TopShare, "0%" ) & " of the total. ",
			        _ClassA & " of " & _Items & " items (" & FORMAT ( _ShareA, "0%" )
			            & ") generate " & FORMAT ( _ValueShareA, "0%" ) & " of the total. "
			    )
			
			RETURN
			    IF (
			        _Items > 0,
			        _Metric & " is " & _Level & " by " & _AxisName & ": " & _Core
			            & "Top item: " & _TopName & " (" & FORMAT ( _TopShare, "0.0%" ) & " of total). "
			            & IF (
			                _ClassA = 0 || _ShareA <= 0.50,
			                _Action,
			                "No small group dominates, so focus should be spread across items."
			            )
			    )
		displayFolder: Pareto
		lineageTag: 44bfebf1-3c9f-4de2-8424-7a9c4d00e5f2

