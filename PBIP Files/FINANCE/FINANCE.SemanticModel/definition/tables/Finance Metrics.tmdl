	measure 'Total Sales MoM %' = ```
			
			VAR CurrentYearSales = [Total Sales]
			VAR PreviousMonthSales = CALCULATE([Total Sales], PREVIOUSMONTH('dim_calendar'[Date]))
			RETURN 
			IF(NOT ISBLANK(PreviousMonthSales),
			DIVIDE(CurrentYearSales,PreviousMonthSales)  -1)
			
