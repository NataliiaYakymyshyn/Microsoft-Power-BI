	measure 'Peak Month by Sales' =
			
			VAR _Months =
			    ADDCOLUMNS (
			        SUMMARIZE ( ALLSELECTED ( dim_calendar ), dim_calendar[Year-Month] ),
			        "@Sales", [Total Sales]
			    )
			VAR _Top =
			    TOPN (
			        1,
			        FILTER ( _Months, NOT ISBLANK ( [@Sales] ) ),
			        [@Sales], DESC,
			        dim_calendar[Year-Month], DESC     // tie-breaker: most recent
			    )
			RETURN
			     MAXX ( _Top, dim_calendar[Year-Month] )
		displayFolder: Best Sales
		lineageTag: 86c4b733-ee54-45ca-bc54-4c1e33d13a90

