	measure 'Profit Margin Band' =
			
			VAR _Margin = [Profit Margin]
			VAR _Low    = [Margin Threshold Low]
			VAR _High   = [Margin Threshold High]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Margin ), BLANK (),
			        _Margin < 0,         "Loss",
			        _Margin < _Low,      "Low",
			        _Margin < _High,     "Healthy",
			                             "Strong"
			    )
		displayFolder: Product & Market
		lineageTag: 6099ad5c-7a8e-404e-ba24-620ec8dd7218

	measure 'Profit Margin Color' =
			
			SWITCH (
			    [Profit Margin Band],
			    "Loss",    "#C0392B",
			    "Low",     "#F5B041",
			    "Healthy", "#A9D18E",
			    "Strong",  "#1E7B34"
			)
		displayFolder: Product & Market
		lineageTag: d9648714-35ea-4d34-8934-238bffd6e176

	measure 'Profit Margin Font Color' =
			
			VAR _Margin = [Profit Margin]
			VAR _Low    = [Margin Threshold Low]
			VAR _High   = [Margin Threshold High]
			VAR _Band =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Margin ), BLANK (),
			        _Margin < 0,         "Loss",
			        _Margin < _Low,      "Low",
			        _Margin < _High,     "Healthy",
			                             "Strong"
			    )
			RETURN
			SWITCH (
			    _Band,
			    "Loss",    "#FFFFFF",
			    "Low",     "#000000",
			    "Healthy", "#000000",
			    "Strong",  "#FFFFFF"
			)
		displayFolder: Product & Market
		lineageTag: 99a4ffb0-e169-4399-9bc9-98b34633eb2f

	measure 'Profit Margin Icon' =
			
			VAR _Color = [Profit Margin Color]
			VAR _Band  = [Profit Margin Band]
			VAR _Shape =
			    SWITCH (
			        _Band,
			        "Loss",    "<path d='M3 3 L13 13 M13 3 L3 13' stroke='" & _Color & "' stroke-width='2.5' stroke-linecap='round'/>",
			        "Low",     "<polygon points='8,2 14,14 2,14' fill='" & _Color & "'/>",
			        "Healthy", "<circle cx='8' cy='8' r='6' fill='" & _Color & "'/>",
			        "Strong",  "<circle cx='8' cy='8' r='6' fill='" & _Color & "'/>"
			    )
			
			RETURN
			    IF (
			        NOT ISBLANK ( _Band ),
			        "data:image/svg+xml;utf8,"
			            & "<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'>"
			            & _Shape
			            & "</svg>"
			    )
		displayFolder: Product & Market
		lineageTag: 76a1e0a8-e902-478c-8be9-249201299522
		dataCategory: ImageUrl

