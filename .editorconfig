root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.tmdl]
end_of_line = crlf
indent_style = tab

[*.{json,pbip,pbir,pbism,platform}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.{md,yml,yaml,py,sh}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
